# ── Next.js / Vercel ──────────────────────────────────────────────────────────

# Base URL of the target site to scrape (no trailing slash)
TARGET_BASE_URL=https://example.com

# CDN host for thumbnail/preview images (no protocol)
IMAGE_CDN_HOST=cdn1.example.com

# CDN host for video stream src (no protocol)
VIDEO_CDN_HOST=cdn2.example.com

# CDN host for download links (no protocol)
DOWNLOAD_CDN_HOST=cdn3.example.com

# Cloudflare Worker forward proxy URL (deploy cloudflare-worker/ first)
PROXY_URL=https://my-proxy-worker.yourname.workers.dev

# Shown in docs page example links
NEXT_PUBLIC_API_BASE_URL=https://your-project.vercel.app
